# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored by default in Next.js, never commit real keys.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
XAI_API_KEY=xai-...
GEMINI_API_KEY=...
META_API_KEY=llama_api_key_...
# Chained (multi-tool, one continuous conversation) batches only support
# Anthropic today regardless of which keys are set above — see
# lib/chained.js. Plan+execute batches and the manual dashboard's
# plan/execute-step/direct modes work with any provider that has a key set.
# Supabase — saved runs storage (see docs/superpowers/specs/2026-08-09-supabase-runs-migration-design.md)
SUPABASE_URL=https://hkqzamibfpyvlowiqgpn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional public document explaining the project's research direction.
RESEARCH_DIRECTION_URL=
# Batch execution trigger — Cloud Run proxy (see docs/superpowers/specs/2026-08-09-batch-execution-infra-design.md)
BATCH_TRIGGER_URL=
BATCH_TRIGGER_SHARED_SECRET=
BATCH_STALE_THRESHOLD_MINUTES=30
# Google sign-in (see README for how to create these) — restricts who can
# reach the app at all, everyone allowed shares the keys above.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
ALLOWED_EMAILS=
ALLOWED_DOMAINS=
# Local development only: set NEEDED to the exact string "false" to skip
# Google sign-in and have every request act as LOCAL_AUTHENTICATION_EMAIL.
# Ignored entirely when NODE_ENV=production, so it cannot weaken a deploy.
# Leave both unset to always use real sign-in.
LOCAL_AUTHENTICATION_NEEDED=
LOCAL_AUTHENTICATION_EMAIL=
